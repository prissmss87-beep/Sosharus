generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  name       String  @unique
  email      String  @unique
  age        String?
  password   String
  bio        String?
  music      String?
  profileUrl String? @unique
  background String?
  discord    String?
  instagram  String?
  steam      String?
}
